{
  "name": "tef-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter web build && node -e \"require('fs').cpSync('apps/web/dist', 'dist', {recursive: true})\"",
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build && node -e \"require('fs').cpSync('apps/web/dist', 'dist', {recursive: true})\"",
    "lint:web": "pnpm --filter web lint",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  }
}
