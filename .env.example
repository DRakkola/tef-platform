# ==============================================================================
# TEF Platform — Master Environment Variables Baseline (.env.example)
# ==============================================================================
# This document lists and describes all environment variables used by the
# backend API, workers, databases, object storage, and frontend.
#
# Environment Profiles:
#   - For local development:  cp .env.development.example .env
#   - For staging deployment: review .env.staging.example
#   - For production launch:  review .env.production.example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General & Core Application Settings
# ------------------------------------------------------------------------------
# Operating environment: "development", "staging", "production", or "testing"
ENVIRONMENT=development

# Descriptive name of the service
PROJECT_NAME="TEF Platform API"

# URL prefix for all REST endpoints (must be /api/v1)
API_V1_PREFIX=/api/v1

# Secret key used for signing JWTs, session cookies, and cryptographic hashes.
# IN PRODUCTION: Must be at least 32 characters, high entropy. Server aborts if default is used.
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-long

# ------------------------------------------------------------------------------
# 2. Server & Ingress Network Settings
# ------------------------------------------------------------------------------
# Host interface to bind (0.0.0.0 binds to all container interfaces)
HOST=0.0.0.0

# HTTP Port for Uvicorn
PORT=8000

# Allowed CORS origins (comma-separated string or JSON array).
# IN PRODUCTION: Strictly limited to production domains; zero localhost or wildcards allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Authentication & Security Policy
# ------------------------------------------------------------------------------
# JWT signing algorithm (HS256)
JWT_ALGORITHM=HS256

# Lifetime of short-lived JWT access token in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Lifetime of refresh token in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# SameSite attribute for auth cookies: "lax", "strict", or "none" (default: "lax")
COOKIE_SAMESITE=lax

# Optional domain attribute for cookies (e.g. ".tef-prep.example.com")
COOKIE_DOMAIN=

# Rate limit: Max authentication attempts per minute per IP address (default: 10)
RATE_LIMIT_AUTH_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 4. PostgreSQL 18 (Authoritative System of Record)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tef_platform
POSTGRES_ADMIN_USER=tef_admin
POSTGRES_ADMIN_PASSWORD=tef_admin_secret
POSTGRES_USER=tef_app
POSTGRES_PASSWORD=tef_app_password
DATABASE_URL=postgresql+asyncpg://tef_app:tef_app_password@localhost:5432/tef_platform

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 5. Redis 7.4 (Ephemeral Cache & Queue Broker)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tef_redis_password
REDIS_DB=0
REDIS_URL=redis://:tef_redis_password@localhost:6379/0

# ------------------------------------------------------------------------------
# 6. Celery Async Worker Broker & Result Backend
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://:tef_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:tef_redis_password@localhost:6379/2

# ------------------------------------------------------------------------------
# 7. Object Storage (MinIO / S3 Private Storage)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_dev_secret
STORAGE_BUCKET_NAME=tef-private
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 8. Payment Provider (Stripe Live / Sandbox / Mock)
# ------------------------------------------------------------------------------
# "stripe" for real/sandbox Stripe gateway, or "mock" for offline deterministic testing
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_mock_key_for_development
STRIPE_PUBLISHABLE_KEY=pk_test_mock_key_for_development
STRIPE_WEBHOOK_SECRET=whsec_mock_key_for_development

# ------------------------------------------------------------------------------
# 9. AI Providers (LLM & Audio Inference)
# ------------------------------------------------------------------------------
# "deepseek", "openai", or "mock"
AI_PROVIDER=mock
DEEPSEEK_API_KEY=mock-deepseek-api-key
OPENAI_API_KEY=mock-openai-api-key

# ------------------------------------------------------------------------------
# 10. Realtime Audio & WebRTC / TURN Settings
# ------------------------------------------------------------------------------
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# ------------------------------------------------------------------------------
# 11. Feature Flags & Private Beta Safety Controls
# ------------------------------------------------------------------------------
PRACTICE_POOL_ENABLED=true
AI_SPEAKING_ENABLED=true
AI_WRITING_ENABLED=true
BOOKINGS_ENABLED=true
CHECKOUT_ENABLED=true
MAINTENANCE_MODE=false

# ------------------------------------------------------------------------------
# 12. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
