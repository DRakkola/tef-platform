# ==============================================================================
# TEF Platform — Production Environment Configuration (.env.production.example)
# ==============================================================================
# Production deployment configuration template.
# ZERO DEFAULT PASSWORDS ALLOWED: The backend will fail startup if defaults are detected.
# All secrets MUST be injected via your cloud secret manager / orchestration system.
# ==============================================================================

# Application General
ENVIRONMENT=production
PROJECT_NAME="TEF Platform API"
API_V1_PREFIX=/api/v1
# MUST be generated: openssl rand -hex 32 (min 32 chars)
SECRET_KEY=change_me_to_a_high_entropy_production_secret_key_at_least_32_chars

# Server Settings
HOST=0.0.0.0
PORT=8000
# Production domain(s) only - strictly NO localhost origins
CORS_ORIGINS=https://tef-prep.example.com,https://app.tef-prep.example.com

# PostgreSQL 18 (Private internal Docker network; no host port exposed)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tef_production
POSTGRES_ADMIN_USER=tef_admin
POSTGRES_ADMIN_PASSWORD=change_me_super_strong_production_admin_password
POSTGRES_USER=tef_app
POSTGRES_PASSWORD=change_me_super_strong_production_app_password
DATABASE_URL=postgresql+asyncpg://tef_app:change_me_super_strong_production_app_password@postgres:5432/tef_production

# Redis 7.4 (Private internal Docker network; no host port exposed)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_super_strong_production_redis_password
REDIS_URL=redis://:change_me_super_strong_production_redis_password@redis:6379/0

# Celery Background Processing
CELERY_BROKER_URL=redis://:change_me_super_strong_production_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_super_strong_production_redis_password@redis:6379/2

# Object Storage (MinIO / S3 Private Storage)
STORAGE_ENDPOINT=s3.amazonaws.com
STORAGE_ACCESS_KEY=change_me_production_s3_access_key
STORAGE_SECRET_KEY=change_me_production_s3_secret_key
STORAGE_BUCKET_NAME=tef-production-private
STORAGE_USE_SSL=true
STORAGE_REGION=eu-west-3

# Payment Provider (Stripe Live Mode)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=rk_live_placeholder_stripe_restricted_key
STRIPE_PUBLISHABLE_KEY=pk_live_placeholder_stripe_pub_key
STRIPE_WEBHOOK_SECRET=whsec_live_placeholder_webhook_secret

# AI Providers (Production API keys with rate limits & billing caps)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=production_deepseek_api_key_placeholder
OPENAI_API_KEY=production_openai_api_key_placeholder

# WebRTC / TURN Settings (Hardened coturn cluster with TLS)
STUN_SERVER=stun:turn.tef-prep.example.com:3478
TURN_SERVER=turns:turn.tef-prep.example.com:5349
TURN_USERNAME=production_turn_user
TURN_PASSWORD=change_me_super_strong_production_turn_password

# Frontend Configuration
VITE_API_URL=https://app.tef-prep.example.com/api/v1
VITE_WS_URL=wss://app.tef-prep.example.com/ws
