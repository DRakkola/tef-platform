# ==============================================================================
# TEF Platform — Staging Environment Configuration (.env.staging.example)
# ==============================================================================
# Pre-production validation environment.
# All private infrastructure (PostgreSQL, Redis, MinIO) is unexposed to the host.
# Secrets MUST be injected via secret manager/CI/CD deployment.
# ==============================================================================

# Application General
ENVIRONMENT=staging
PROJECT_NAME="TEF Platform API (Staging)"
API_V1_PREFIX=/api/v1
# MUST be generated: openssl rand -hex 32
SECRET_KEY=change_me_to_a_secure_staging_secret_key_min_32_chars_long

# Server Settings
HOST=0.0.0.0
PORT=8000
# Staging domain(s) only - NO localhost origins
CORS_ORIGINS=https://staging.tef-prep.example.com

# PostgreSQL 18 (Isolated internal Docker network; no host port exposed)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tef_staging
POSTGRES_ADMIN_USER=tef_admin
POSTGRES_ADMIN_PASSWORD=change_me_staging_admin_password
POSTGRES_USER=tef_app
POSTGRES_PASSWORD=change_me_staging_app_password
DATABASE_URL=postgresql+asyncpg://tef_app:change_me_staging_app_password@postgres:5432/tef_staging

# Redis 7.4 (Isolated internal Docker network; no host port exposed)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_staging_redis_password
REDIS_URL=redis://:change_me_staging_redis_password@redis:6379/0

# Celery Background Processing
CELERY_BROKER_URL=redis://:change_me_staging_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_staging_redis_password@redis:6379/2

# Object Storage (MinIO / S3 Private Storage)
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=staging_storage_app_key
STORAGE_SECRET_KEY=change_me_staging_storage_secret
STORAGE_BUCKET_NAME=tef-staging-private
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1

# Payment Provider (Stripe Test Mode)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_staging_placeholder_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_staging_placeholder_stripe_pub_key
STRIPE_WEBHOOK_SECRET=whsec_staging_placeholder_webhook_secret

# AI Providers (Staging keys or Mock)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=staging_deepseek_api_key_placeholder
OPENAI_API_KEY=staging_openai_api_key_placeholder

# WebRTC / TURN Settings (Staging coturn credentials)
STUN_SERVER=stun:staging-turn.tef-prep.example.com:3478
TURN_SERVER=turn:staging-turn.tef-prep.example.com:3478
TURN_USERNAME=staging_turn_user
TURN_PASSWORD=change_me_staging_turn_password

# Frontend Configuration
VITE_API_URL=https://staging.tef-prep.example.com/api/v1
VITE_WS_URL=wss://staging.tef-prep.example.com/ws
